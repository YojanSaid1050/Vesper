# ============================================
# Vesper Bot - Configuración
# ============================================

# Discord
TOKEN=tu_token_discord_aqui
CLIENT_ID=1507223570860867725
GUILD_ID=1506580021232406540

# Servidor principal. Los paneles, diagnósticos, roles especiales, historial y
# comandos de administración avanzada solo se registran aquí.
MAIN_GUILD_ID=1506580021232406540

# Lista de servidores secundarios autorizados. Si se deja vacía, solo se
# atenderá al servidor Main.
APPROVED_GUILD_IDS=
# Main temáticos con administración local y personalidad propia. Ankerie
# Dimension ya queda registrado en esta distribución.
THEMED_MAIN_GUILD_IDS=1124871897688055818
THEMED_MAIN_DEFAULT_NAME=AnkeBot
# Compatibilidad temporal. No se recomienda en producción.
ALLOW_UNLISTED_GUILDS=false

# Propietarios globales del bot, separados por coma. Son los únicos que pueden
# ejecutar operaciones que afectan a todos los servidores.
BOT_OWNER_IDS=649059737635258389

# Roles de capacidades del servidor Main. Los permisos nativos de Discord
# (Administrador, Moderar miembros y Gestionar canales) siguen funcionando.
SOCIAL_MANAGER_ROLE_IDS=id_rol_redes
MODERATOR_ROLE_IDS=id_rol_moderacion
MUSIC_DJ_ROLE_IDS=id_rol_dj

# Twitch API
TWITCH_CLIENT_ID=tu_twitch_client_id
TWITCH_CLIENT_SECRET=tu_twitch_client_secret

# TikTok autohospedado: no requiere tokens ni créditos.
TIKTOK_ENABLED=true
TIKTOK_LIVE_INTERVAL_MINUTES=10
TIKTOK_VIDEO_INTERVAL_MINUTES=60
TIKTOK_LIVE_CACHE_MINUTES=5
TIKTOK_VIDEO_CACHE_MINUTES=30
TIKTOK_CONCURRENCY=2
TIKTOK_REQUEST_DELAY_MS=900
TIKTOK_REQUEST_TIMEOUT_MS=30000

# Solo es necesario cuando Chromium no se detecta automáticamente.
TIKTOK_BROWSER_TIMEOUT_MS=60000
TIKTOK_PAGE_SETTLE_MS=3000
# Solo actívalo si el proveedor de contenedores no permite el sandbox de Chromium.
TIKTOK_BROWSER_NO_SANDBOX=false
# TIKTOK_BROWSER_PATH=/usr/bin/chromium

# YouTube API
YOUTUBE_API_KEY=tu_youtube_api_key

# MongoDB
MONGODB_URI=tu_mongodb_uri

# ============================================
# Configuración del Bot
# ============================================

# Usar comandos locales (true) o globales (false)
USE_GUILD_COMMANDS=false
# Debe estar activo al menos durante el siguiente despliegue para publicar
# /panel y sincronizar el catálogo reducido.
REGISTER_COMMANDS=true

# Puerto para el servidor web
PORT=3000

# ============================================
# Panel web nativo (opcional)
# ============================================

# Activa la interfaz en /panel. El bot sigue funcionando si está en false.
WEB_DASHBOARD_ENABLED=true
# Cuando el panel ya esté configurado, activa este valor y vuelve a registrar
# comandos para ocultar la administración redundante de Discord.
WEB_ADMIN_MODE=false
# URL pública exacta, sin barra final. La URL gratuita del alojamiento sirve.
WEB_BASE_URL=https://vesper-q5jv.onrender.com
# Genera una clave: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# WEB_SESSION_SECRET=Render puede generarla automáticamente desde render.yaml
WEB_SESSION_HOURS=24
WEB_AUDIT_DAYS=180
WEB_TRUST_PROXY=1
# Se detecta automáticamente desde WEB_BASE_URL; normalmente no hay que cambiarlo.
# WEB_COOKIE_SECURE=true

# Discord OAuth. Puede reutilizar CLIENT_ID y necesita añadir en el portal:
# https://vesper-q5jv.onrender.com/auth/discord/callback
# DISCORD_OAUTH_CLIENT_ID=
# DISCORD_OAUTH_CLIENT_SECRET=

# Google es opcional. Añade como URI autorizada:
# https://vesper-q5jv.onrender.com/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Correos propietarios, separados por coma. Deben ser cuentas verificadas.
GOOGLE_OWNER_EMAILS=xyojansaidx@gmail.com

# Debug (opcional)
DEBUG=false
LOG_ERRORS=true

# Tiempo de pausa de un monitor tras varios errores consecutivos (milisegundos)
MONITOR_ERROR_COOLDOWN_MS=300000

# Historial central de notificaciones
NOTIFICATION_HISTORY_DAYS=90

# Música gratuita autohospedada (opcional).
# En el Dockerfile/Render se inicia dentro del mismo contenedor. Para una
# instalación local puedes usar docker compose -f docker-compose.music.yml up -d.
LAVALINK_EMBEDDED=true
LAVALINK_URL=http://127.0.0.1:2333
LAVALINK_PASSWORD=cambia_esta_contrasena
LAVALINK_REQUEST_TIMEOUT_MS=15000
# Si es true, /ready falla cuando Lavalink se desconecta. Se recomienda false
# para que una avería musical no reinicie todo el bot.
MUSIC_REQUIRED=false

# Rutas (opcional)
DATA_PATH=./data
LOGS_PATH=./logs
