# ============================================
# Vesper Bot - Configuración
# ============================================

# Discord
TOKEN=tu_token_discord_aqui
CLIENT_ID=tu_client_id_aqui
GUILD_ID=tu_guild_id_aqui_opcional

# Servidor principal. Los paneles, diagnósticos, roles especiales, historial y
# comandos de administración avanzada solo se registran aquí.
MAIN_GUILD_ID=tu_guild_principal

# Lista opcional de servidores secundarios autorizados. Si se deja vacía se
# conservan por compatibilidad los servidores donde el bot ya está instalado.
APPROVED_GUILD_IDS=id_secundario_1,id_secundario_2

# Propietarios globales del bot, separados por coma. Son los únicos que pueden
# ejecutar operaciones que afectan a todos los servidores.
BOT_OWNER_IDS=tu_id_de_usuario_discord

# Roles de capacidades del servidor Main. Los permisos nativos de Discord
# (Administrador, Moderar miembros y Gestionar canales) siguen funcionando.
SOCIAL_MANAGER_ROLE_IDS=id_rol_redes
MODERATOR_ROLE_IDS=id_rol_moderacion
MUSIC_DJ_ROLE_IDS=id_rol_dj

# Twitch API
TWITCH_CLIENT_ID=tu_twitch_client_id
TWITCH_CLIENT_SECRET=tu_twitch_client_secret

# TikTok autohospedado: no requiere tokens ni créditos.
TIKTOK_ENABLED=true
TIKTOK_LIVE_INTERVAL_MINUTES=10
TIKTOK_VIDEO_INTERVAL_MINUTES=60
TIKTOK_LIVE_CACHE_MINUTES=5
TIKTOK_VIDEO_CACHE_MINUTES=30
TIKTOK_CONCURRENCY=2
TIKTOK_REQUEST_DELAY_MS=900
TIKTOK_REQUEST_TIMEOUT_MS=30000

# Solo es necesario cuando Chromium no se detecta automáticamente.
TIKTOK_BROWSER_TIMEOUT_MS=60000
TIKTOK_PAGE_SETTLE_MS=3000
# TIKTOK_BROWSER_PATH=/usr/bin/chromium

# YouTube API
YOUTUBE_API_KEY=tu_youtube_api_key

# MongoDB
MONGODB_URI=tu_mongodb_uri

# ============================================
# Configuración del Bot
# ============================================

# Usar comandos locales (true) o globales (false)
USE_GUILD_COMMANDS=true

# Puerto para el servidor web
PORT=3000

# Debug (opcional)
DEBUG=false
LOG_ERRORS=true

# Tiempo de pausa de un monitor tras varios errores consecutivos (milisegundos)
MONITOR_ERROR_COOLDOWN_MS=300000

# Historial central de notificaciones
NOTIFICATION_HISTORY_DAYS=90

# Música gratuita autohospedada (opcional)
# Inicia Lavalink con: docker compose -f docker-compose.music.yml up -d
LAVALINK_URL=http://127.0.0.1:2333
LAVALINK_PASSWORD=cambia_esta_contrasena

# Rutas (opcional)
DATA_PATH=./data
LOGS_PATH=./logs
