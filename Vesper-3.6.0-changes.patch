+
+# Discord (obligatorio)
+TOKEN=
+CLIENT_ID=
+MAIN_GUILD_ID=
+
+# Servidores autorizados
+APPROVED_GUILD_IDS=
+THEMED_MAIN_GUILD_IDS=
+THEMED_MAIN_DEFAULT_NAME=AnkeBot
+ALLOW_UNLISTED_GUILDS=false
+
+# Propietarios y roles globales (IDs separados por coma)
+BOT_OWNER_IDS=
+SOCIAL_MANAGER_ROLE_IDS=
+MODERATOR_ROLE_IDS=
+MUSIC_DJ_ROLE_IDS=
+
+# Base de datos (obligatorio)
+MONGODB_URI=
+GUILD_CONFIG_CACHE_MS=30000
+
+# Registro de comandos
+USE_GUILD_COMMANDS=false
+REGISTER_COMMANDS=true
+
+# Panel web
+PORT=3000
+WEB_DASHBOARD_ENABLED=true
+WEB_ADMIN_MODE=false
+WEB_BASE_URL=http://localhost:3000
+WEB_SESSION_SECRET=
+WEB_SESSION_HOURS=24
+WEB_AUDIT_DAYS=180
+WEB_TRUST_PROXY=1
+WEB_COOKIE_SECURE=false
+
+# OAuth de Discord. Si queda vacío, OAuth usa CLIENT_ID.
+DISCORD_OAUTH_CLIENT_ID=
+DISCORD_OAUTH_CLIENT_SECRET=
+
+# OAuth de Google (opcional)
+GOOGLE_CLIENT_ID=
+GOOGLE_CLIENT_SECRET=
+GOOGLE_OWNER_EMAILS=
+
+# Plataformas opcionales
+TWITCH_CLIENT_ID=
+TWITCH_CLIENT_SECRET=
+YOUTUBE_API_KEY=
+TIKTOK_ENABLED=true
+TIKTOK_LIVE_INTERVAL_MINUTES=10
+TIKTOK_VIDEO_INTERVAL_MINUTES=60
+TIKTOK_LIVE_CACHE_MINUTES=5
+TIKTOK_VIDEO_CACHE_MINUTES=30
+TIKTOK_CONCURRENCY=2
+TIKTOK_REQUEST_DELAY_MS=900
+TIKTOK_REQUEST_TIMEOUT_MS=30000
+TIKTOK_BROWSER_TIMEOUT_MS=60000
+TIKTOK_PAGE_SETTLE_MS=3000
+TIKTOK_BROWSER_PATH=
+
+# Música autohospedada
+LAVALINK_EMBEDDED=true
+LAVALINK_URL=
+LAVALINK_PASSWORD=
+LAVALINK_REQUEST_TIMEOUT_MS=15000
+MUSIC_REQUIRED=false
+MUSIC_RESOLVE_TIMEOUT_MS=30000
+YTDLP_PATH=
+FFMPEG_PATH=
+
+# Planes y operación
+PREMIUM_GUILD_IDS=
+NOTIFICATION_HISTORY_DAYS=90
+MONITOR_ERROR_COOLDOWN_MS=300000
+DATA_PATH=./data
+LOGS_PATH=./logs
+DEBUG=false
+LOG_ERRORS=true
